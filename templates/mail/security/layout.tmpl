{{- /*
security_alert tells the reader about a change to the security of their
account, with when and where it happened. Call it with (dict "Alert" . "Body"
... "Path" ... "Label" ...), where Path is where to go when the reader did not
make the change.
*/ -}}
{{define "security_alert" -}}
<p>{{Tr "mail.greeting" .Alert.Username}}</p>
<p>{{.Body}}</p>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:16px 0;background-color:#f4f4f5;border-radius:6px;">
<tr><td style="padding:8px 16px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
<tr><td style="width:120px;padding:4px 0;font-size:12px;color:#71717a;vertical-align:top;">{{Tr "mail.security.when"}}</td><td style="padding:4px 0;">{{.Alert.Time}}</td></tr>
<tr><td style="width:120px;padding:4px 0;font-size:12px;color:#71717a;vertical-align:top;">{{Tr "mail.security.browser"}}</td><td style="padding:4px 0;">{{.Alert.Browser}}</td></tr>
<tr><td style="width:120px;padding:4px 0;font-size:12px;color:#71717a;vertical-align:top;">{{Tr "mail.security.ip"}}</td><td style="padding:4px 0;">{{.Alert.IP}}</td></tr>
</table>
</td></tr>
</table>
{{template "footnote" (Tr "mail.security.not_you")}}
{{template "button" (dict "URL" (printf "%s%s" AppURL .Path) "Label" .Label)}}
{{- end}}
