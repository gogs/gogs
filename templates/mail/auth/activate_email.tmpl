{{$link := printf "%suser/activate_email?code=%s&email=%s" AppURL (urlquery .Code) (urlquery .Email) -}}
{{template "header" (Tr "mail.activate_email")}}
<p>{{Tr "mail.greeting" .Username}}</p>
<p>{{Tr "mail.activate_email.body" .Email .ActiveCodeLives}}</p>
{{template "button" (dict "URL" $link "Label" (Tr "mail.activate_email.action"))}}
{{template "footer"}}
